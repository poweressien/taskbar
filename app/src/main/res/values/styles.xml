<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.Et.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/et_card</item>
        <item name="cardCornerRadius">14dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/et_stroke</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="TextAppearance.Et.Section" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textColor">@color/et_accent</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.06</item>
    </style>
</resources>
